rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /students/{studentId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == 'Y79AJ2xs8mTjaWepHml1lA74fj83';
    }

    // Student private/public records: only the designated admin can access.
    match /students_private/{studentId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == 'Y79AJ2xs8mTjaWepHml1lA74fj83';
    }

    match /students_public/{studentId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == 'Y79AJ2xs8mTjaWepHml1lA74fj83';
    }

    match /nmmse_results/{resultId} {
      // Students may submit only their own authenticated session's result.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'date', 'name', 'subject', 'group', 'score', 'total',
          'percent', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'date', 'name', 'subject', 'group', 'score', 'total',
          'percent', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.subject in ['MAT', 'SAT', 'FULL MOCK']
        && request.resource.data.group is int
        && request.resource.data.group >= 1
        && request.resource.data.score is int
        && request.resource.data.total is int
        && request.resource.data.total > 0
        && request.resource.data.total <= 100
        && request.resource.data.score >= 0
        && request.resource.data.score <= request.resource.data.total
        && request.resource.data.percent is int
        && request.resource.data.percent >= 0
        && request.resource.data.percent <= 100
        && request.resource.data.createdAt is int
        && request.resource.data.date is string
        && request.resource.data.date.size() <= 50;

      // Only the designated school administrator can read results.
      allow read: if request.auth != null
        && request.auth.uid == 'Y79AJ2xs8mTjaWepHml1lA74fj83';

      // Results are immutable; only admin can delete if needed.
      allow update: if false;
      allow delete: if request.auth != null
        && request.auth.uid == 'Y79AJ2xs8mTjaWepHml1lA74fj83';
    }

    // Daily and monthly attendance: only the designated school admin can access records.
    match /attendance/{attendanceId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == 'Y79AJ2xs8mTjaWepHml1lA74fj83';
    }

    // Admin-managed teacher records.
    match /teachers/{teacherId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == 'Y79AJ2xs8mTjaWepHml1lA74fj83';
    }

    // Public teacher cards expose only approved profile fields.
    // The public website can read; only the designated admin can publish/update.
    match /teachers_public/{teacherId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.uid == 'Y79AJ2xs8mTjaWepHml1lA74fj83';
    }

    // Exams and their marks are restricted to the designated school admin.
    match /exams/{examId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == 'Y79AJ2xs8mTjaWepHml1lA74fj83';

      match /marks/{markId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == 'Y79AJ2xs8mTjaWepHml1lA74fj83';
      }
    }

    // Upcoming school events are public; only the designated admin can manage them.
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.uid == 'Y79AJ2xs8mTjaWepHml1lA74fj83';
    }

    // Notices are publicly readable; only the designated admin can manage them.
    match /notices/{noticeId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.uid == 'Y79AJ2xs8mTjaWepHml1lA74fj83';
    }

    match /birthdays/{birthdayId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.uid == 'Y79AJ2xs8mTjaWepHml1lA74fj83';
    }

    // Student Creativity Corner submissions
    match /creativity_submissions/{submissionId} {
      // Public visitors can see approved work; the designated admin can see all.
      allow read: if resource.data.status == 'approved'
        || (request.auth != null
          && request.auth.uid == 'Y79AJ2xs8mTjaWepHml1lA74fj83');

      // Students may submit moderated work with a strict field allowlist.
      allow create: if request.resource.data.keys().hasOnly([
          'studentName', 'className', 'category', 'title',
          'description', 'mediaUrl', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'studentName', 'className', 'category', 'title',
          'description', 'mediaUrl', 'status', 'createdAt'
        ])
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() > 0
        && request.resource.data.studentName.size() <= 80
        && request.resource.data.className in ['6', '7', '8']
        && request.resource.data.category in [
          'कला एवं चित्रकारी', 'कहानी, कविता एवं लेखन',
          'विज्ञान एवं नवाचार मॉडल', 'गायन, नृत्य एवं अभिनय',
          'मेरी उपलब्धियाँ', 'पुस्तक समीक्षा',
          'हरित विद्यालय गतिविधि', 'ज्ञान चुनौती'
        ]
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 1800
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaUrl.size() <= 1000
        && request.resource.data.status == 'pending';

      // Only the designated admin can approve, reject, or delete submissions.
      allow update, delete: if request.auth != null
        && request.auth.uid == 'Y79AJ2xs8mTjaWepHml1lA74fj83';
    }

    // Teacher Corner: anonymous sessions can access only school teacher-work records.
    // UDISE is a shared school identifier, not a private credential; do not store student-sensitive data here.
    match /teacher_corner/{schoolCode}/records/{recordId} {
      allow read: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && schoolCode == '22130305808';
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && schoolCode == '22130305808'
        && request.resource.data.keys().hasOnly(['kind', 'payload', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['kind', 'payload', 'createdAt', 'updatedAt'])
        && request.resource.data.kind in ['plans', 'diary', 'activities']
        && request.resource.data.payload is map
        && request.resource.data.payload.keys().hasOnly(['date', 'className', 'subject', 'title', 'notes', 'meta', 'teacherName', 'book', 'chapter', 'outcomes', 'competencies', 'resources', 'activities', 'assessment', 'homework', 'period', 'activity'])
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int;
      allow update: if false;
      allow delete: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && schoolCode == '22130305808';
    }


    // CTET Mock Test results: each Google-authenticated teacher account can access only its own private attempts.
    match /ctet_results/{userId}/attempts/{attemptId} {
      allow read: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'date', 'studentName', 'paper', 'testNo', 'group',
          'language1', 'language2', 'score', 'wrong', 'unanswered',
          'percentage', 'eligibility', 'sectionMarks'
        ])
        && request.resource.data.keys().hasAll([
          'date', 'studentName', 'paper', 'testNo', 'score',
          'wrong', 'unanswered', 'percentage', 'eligibility', 'sectionMarks'
        ])
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() > 0
        && request.resource.data.studentName.size() <= 80
        && request.resource.data.paper in ['I', 'II']
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 90
        && request.resource.data.wrong is int
        && request.resource.data.unanswered is int
        && request.resource.data.percentage is number
        && request.resource.data.sectionMarks is list
        && request.resource.data.sectionMarks.size() <= 5;
      allow update, delete: if false;
    }

  }
}
